{
  "name": "tasktips-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.22.0"
  },
  "overrides": {
    "glob": "10.5.0"
  },
  "scripts": {
    "predev": "npm run generate:api",
    "dev": "vite",
    "prebuild": "npm run generate:api",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "generate:api": "openapi-typescript ../contracts/openapi.yaml -o src/api/generated/schema.ts && prettier --write src/api/generated/schema.ts",
    "lint:openapi": "redocly lint --config ../redocly.yaml ../contracts/openapi.yaml",
    "check": "npm run lint:openapi && npm run generate:api && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "echarts": "6.1.0",
    "element-plus": "2.14.5",
    "pinia": "4.0.3",
    "vue": "3.5.41",
    "vue-i18n": "11.4.9",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@redocly/cli": "2.47.0",
    "@types/node": "26.2.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "eslint": "10.9.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.10.0",
    "happy-dom": "20.11.6",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11"
  }
}
