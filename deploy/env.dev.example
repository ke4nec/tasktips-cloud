# Defaults for running tasktips-api / tasktips-worker on the host against
# deploy/compose.dev.yaml. Copy to deploy/.env.dev (git-ignored), then:
#   set -a; . deploy/.env.dev; set +a

TASKTIPS_BIND_ADDRESS=127.0.0.1:8080
TASKTIPS_DATABASE_URL=postgres://tasktips:tasktips-dev@127.0.0.1:5432/tasktips
RUSTFS_ENDPOINT=http://127.0.0.1:9000
RUSTFS_REGION=us-east-1
RUSTFS_BUCKET=tasktips-data
RUSTFS_ACCESS_KEY=tasktips-dev
RUSTFS_SECRET_KEY=tasktips-dev-secret
TASKTIPS_JWT_ISSUER=tasktips-cloud
TASKTIPS_JWT_AUDIENCE=tasktips-desktop
# Generate a dev key with: openssl genpkey -algorithm ed25519 -out deploy/jwt-dev.pem
# TASKTIPS_JWT_PRIVATE_KEY_FILE=deploy/jwt-dev.pem
TASKTIPS_ACCESS_TOKEN_TTL_SECONDS=900
TASKTIPS_REFRESH_TOKEN_TTL_SECONDS=2592000
TASKTIPS_MAX_PUSH_OBJECTS=100
TASKTIPS_MAX_PUSH_JSON_BYTES=2097152
RUST_LOG=debug
