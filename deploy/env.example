# TaskTips Cloud 部署配置。最小上线流程只有两步：
#
#   bash deploy/setup.sh --domain https://example.com
#   docker compose --env-file deploy/.env -f deploy/compose.yaml pull
#   docker compose --env-file deploy/.env -f deploy/compose.yaml up -d
#
# setup.sh 会补全下方缺失的密码类变量并生成 JWT 私钥，已存在的值不会被覆盖。
# 数据库 DSN 由 Compose 用服务名自动组装，无需手写。

# 公网入口。默认 http://localhost 表示纯 HTTP（不申请证书），适合本机或内网；
# 需要 HTTPS 时改为 https://你的域名（需 DNS 解析到本机并放行 80/443），Caddy 自动申请证书。
TASKTIPS_PUBLIC_BASE_URL=http://localhost
# 浏览器打开管理后台的 origin，必须与上精确一致（含协议、无尾斜杠）。
# 注意：管理后台 refresh Cookie 带 Secure 标记，明文 HTTP 下只有 localhost
# 能用；局域网 IP 访问每次登录有效期约 15 分钟，生产请用 HTTPS。
TASKTIPS_ADMIN_ORIGIN=http://localhost
# Default image tags track the release version (0.1.0): bump them together
# with Cargo.toml, admin/package.json, contracts/openapi.yaml and the
# Dockerfiles' APP_VERSION.
TASKTIPS_BACKEND_IMAGE=ke4nec/tasktips-cloud:0.1.0
TASKTIPS_ADMIN_IMAGE=ke4nec/tasktips-cloud-admin:0.1.0

# --- 以下由 setup.sh 自动生成，一般不用手改 ---
# 数据库与对象存储凭据（只允许字母数字，以免拼进 URL 后失效）。
POSTGRES_USER=tasktips
POSTGRES_DATABASE=tasktips
# POSTGRES_PASSWORD=
# RUSTFS_ACCESS_KEY=
# RUSTFS_SECRET_KEY=
# TASKTIPS_CURSOR_SIGNING_SECRET=
# JWT 私钥文件（setup.sh 生成，容器内以 uid 65532 读取）。
# TASKTIPS_JWT_PRIVATE_KEY_SOURCE=./secrets/tasktips_jwt_private_key
