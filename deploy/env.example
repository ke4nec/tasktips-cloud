TASKTIPS_PUBLIC_BASE_URL=http://localhost
TASKTIPS_BIND_ADDRESS=0.0.0.0:8080
TASKTIPS_DATABASE_URL=postgres://tasktips:replace-with-a-strong-password@postgres:5432/tasktips
POSTGRES_DATABASE=tasktips
POSTGRES_USER=tasktips
POSTGRES_PASSWORD=replace-with-a-strong-password
RUSTFS_ENDPOINT=http://rustfs:9000
RUSTFS_REGION=us-east-1
RUSTFS_BUCKET=tasktips-data
RUSTFS_ACCESS_KEY=replace-with-a-random-access-key
RUSTFS_SECRET_KEY=replace-with-a-random-secret-key
TASKTIPS_JWT_ISSUER=tasktips-cloud
TASKTIPS_JWT_AUDIENCE=tasktips-desktop
TASKTIPS_JWT_PRIVATE_KEY_FILE=/run/secrets/tasktips_jwt_private_key
TASKTIPS_ACCESS_TOKEN_TTL_SECONDS=900
TASKTIPS_REFRESH_TOKEN_TTL_SECONDS=2592000
TASKTIPS_MAX_PUSH_OBJECTS=100
TASKTIPS_MAX_PUSH_JSON_BYTES=2097152
RUST_LOG=info
TASKTIPS_ADMIN_LOCALE=zh-CN

