# Admin console image for TaskTips Cloud: static frontend behind nginx.
#
# Published to Docker Hub as ke4nec/tasktips-cloud-admin and consumed via
# ${TASKTIPS_ADMIN_IMAGE} in deploy/compose.yaml (local `build` still works
# as a fallback). Caddy in front strips the /admin prefix, so nginx serves
# the files from /.
#
# APP_VERSION must stay in sync with admin/package.json, the Cargo workspace
# version and contracts/openapi.yaml info.version. CI passes the release
# version explicitly (--build-arg APP_VERSION=...); the default here is the
# current release so local builds embed the same version. The value is
# forwarded as VITE_APP_VERSION so the built console displays it.
ARG APP_VERSION=0.1.0
FROM node:22.22.3-bookworm AS builder

ARG APP_VERSION=0.1.0
ENV VITE_APP_VERSION=${APP_VERSION}

WORKDIR /app
COPY admin/package.json admin/package-lock.json ./
# The npm cache mount speeds up reinstalls; CI persists it via the BuildKit
# cache backend (type=gha,mode=max).
RUN --mount=type=cache,target=/root/.npm npm ci
COPY admin ./
COPY contracts /contracts
RUN npm run build

FROM nginx:1.31.4-alpine

ARG APP_VERSION=0.1.0
LABEL org.opencontainers.image.title="TaskTips Cloud admin" \
      org.opencontainers.image.version="${APP_VERSION}"
ENV TASKTIPS_VERSION=${APP_VERSION}

COPY deploy/nginx.admin.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 8080
